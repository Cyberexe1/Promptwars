NODE_ENV=development
PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# Local development only. Production uses an App Runner IAM role.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

DDB_TABLE_NAME=eventplanner-dev
# Optional when using DynamoDB Local, for example http://localhost:8000
DDB_ENDPOINT=

BEDROCK_MODEL_ID=
JWT_SECRET=change-this-to-at-least-32-characters
